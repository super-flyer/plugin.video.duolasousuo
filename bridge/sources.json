{
  // 只监听本机回环；Kodi 与 bridge 同机，不对外暴露。
  // 若确实要让内网其他设备访问，把 listen 改成 0.0.0.0 并设置 token，
  // 插件的额外接口填 direct:http://<ip>:8765/api.php/provide/vod/?token=<token>
  "listen": "127.0.0.1",
  "port": 8765,
  "token": "",
  "timeout": 6,
  "deadline": 10,
  "max_workers": 8,
  "cooldown": 1800,
  // FongMi/TVBox 配置（相对工作目录或绝对路径/URL）。
  // 其中 type 0/1 的 HTTP CMS 站点会自动并入源列表；type 3 的 spider 站点只统计、跳过。
  "fongmi_config": "fongmi_config.json",
  "sources": [
    { "name": "无极", "url": "https://api.wujinapi.com/api.php/provide/vod/" },
    { "name": "非凡", "url": "https://cj.ffzyapi.com/api.php/provide/vod/" }
  ]
}
