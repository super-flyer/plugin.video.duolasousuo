{
  // 只监听本机回环；Kodi 与 bridge 同机，不对外暴露。
  // 若确实要让内网其他设备访问，把 listen 改成 0.0.0.0 并设置 token，
  // 插件的额外接口填 direct:http://<ip>:8765/api.php/provide/vod/?token=<token>
  "listen": "127.0.0.1",
  "port": 8765,
  "token": "",
  "timeout": 6,
  "detail_timeout": 5,
  "deadline": 8,
  "spider_budget": 9,
  "max_workers": 8,
  "cooldown": 1800,
  // v2.2 播放地址补全：对 .html 播放页 / 间接 id 做二级取址并写回 vod_play_url。
  // 已是可播 m3u8/mp4 的分集不动；最多解析 40 集，整体预算 6s，结果缓存 10 分钟。
  // 若 Spider 的 playerContent 返回 parse=1，可在此填解析接口前缀，例如
  // "parse_url": "https://parse.example.com/?url="（留空则不处理，标记为不可播）。
  "play_resolve": {
    "enabled": true,
    "max_workers": 8,
    "max_episodes": 40,
    "fetch_timeout": 3,
    "budget": 8,
    "cache_ttl": 600,
    "parse_url": ""
  },
  // FongMi/TVBox 配置（相对工作目录或绝对路径/URL）。
  // 其中 type 0/1 的 HTTP CMS 站点会自动并入源列表；type 3 的 spider 站点只统计、跳过。
  "fongmi_config": "fongmi_config.json",
  // Spider Host（v2.1）：执行第三方 Spider 字节码有风险，默认只启用本地 demo；
  // java.classes 是显式白名单，jar 放在 jars/ 目录（标准 JVM .class 的 spider jar）。
  // Android dex 格式的 csp_*Guard 无法在 Linux JVM 运行，只统计不执行。
  "spider_host": {
    "enabled": true,
    "timeout": 8,
    "python": {
      "enabled": true,
      "spiders": [
        { "name": "DemoSpider", "file": "spiders/demo.py", "ext": "{}" }
      ]
    },
    "js": { "enabled": false, "spiders": [] },
    "java": {
      "enabled": true,
      "jar_dir": "jars",
      // Bili 需有效 B 站 cookie；Wogg 详情无播放列表、SeedHub 详情异常；
      // Zxzj 播放页虽能补全出真实地址，但其媒体域名对当前出口固定 403（与请求头无关）。
      // 以上均已移出白名单，避免搜索结果混入必然打不开的条目。
      // IkBot 实测直接给出 31 条线路的可播 m3u8，是当前唯一稳定可用的 Java Spider。
      // 需要启用播放页补全的 Spider 时，可按下例登记 base_url：
      // { "name": "Zxzj", "class": "Zxzj", "ext": "{}", "base_url": "https://www.zxzj.run/" }
      "classes": [
        { "name": "IkBot", "class": "IkBot", "ext": "{}" }
      ]
    },
    "remote_spider_url": ""
  },
  // v2.3 跨源线路联邦：搜索时记住同名影片在其它源的 id，详情时把它们的线路
  // 合并进同一个列表（按播放域名去重）。某个站点/CDN 挂了仍有其它线路可播，
  // 不必依赖任何单一站点，也不必返回重选源。设为 enabled:false 可关闭。
  "line_federation": {
    "enabled": true,
    "max_peers": 6,
    "max_lines": 12,
    "peer_timeout": 5
  },
  "sources": [
    { "name": "无极", "url": "https://api.wujinapi.com/api.php/provide/vod/" },
    { "name": "非凡", "url": "https://cj.ffzyapi.com/api.php/provide/vod/" },
    { "name": "如意", "url": "https://cj.rycjapi.com/api.php/provide/vod/" },
    { "name": "量子", "url": "https://cj.lziapi.com/api.php/provide/vod/" },
    { "name": "百度", "url": "https://api.apibdzy.com/api.php/provide/vod/" }
  ]
}
